# ============================================================================
# Nexus Legal Integration - Environment Variables (Desarrollo Local)
# ============================================================================
# INSTRUCCIONES:
# 1. Copiar este archivo: cp .env.example .env
# 2. Reemplazar los valores de ejemplo con tus credenciales reales
# 3. NUNCA commitear .env a Git (ya está en .gitignore)
#
# En producción (Cloud Run) estos valores se inyectan via:
#   - GCP Secret Manager  → valores sensibles (tokens, passwords, secrets)
#   - cloudbuild.yaml     → configuración no-sensible (IDs, URLs, flags)
# ============================================================================

# ----------------------------------------------------------------------------
# ClickUp API — obtener en: clickup.com/settings/apps
# ----------------------------------------------------------------------------
CLICKUP_API_TOKEN=pk_YOUR_CLICKUP_API_TOKEN_HERE
CLICKUP_WEBHOOK_SECRET=your_webhook_secret_consultas_agenda
CLICKUP_WEBHOOK_SECRET_ASSIGNMENTS=your_webhook_secret_case_assignment
CLICKUP_TEAM_ID=your_team_id
CLICKUP_LIST_ID=your_list_id_consultas_agenda
CLICKUP_FIELD_ID_AI_LINK=your_ai_link_field_uuid
CLICKUP_FIELD_ID_LINK_INTAKE=your_link_intake_field_uuid

# ----------------------------------------------------------------------------
# Cloud SQL / PostgreSQL
# ----------------------------------------------------------------------------
# Para desarrollo local usar IP directa:
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=nexus_legal_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password_here
DATABASE_SSL_MODE=disable

# Para Cloud Run (socket Unix) — configurar en cloudbuild.yaml, no aquí:
# DATABASE_HOST=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# ----------------------------------------------------------------------------
# Google Sheets — Service Account con acceso al spreadsheet
# ----------------------------------------------------------------------------
GOOGLE_SHEETS_ENABLED=true
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_SHEET_NAME=Leads DVS

# Opción 1: Path a archivo JSON (recomendado para desarrollo local)
GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials.json

# Opción 2: JSON string completo (para Cloud Run vía Secret Manager)
# GOOGLE_SHEETS_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Mapeo campo → número de columna en el spreadsheet (JSON)
GOOGLE_SHEETS_FIELD_MAPPING={"task_id": 1, "task_name": 2, "status": 3, "name": 4, "dvs_name": 5, "link_intake": 6, "url": 7, "date_created": 8, "date_updated": 9}

# ----------------------------------------------------------------------------
# External Dispatch (Enqueuer → Filtros IA)
# ----------------------------------------------------------------------------
EXTERNAL_DISPATCH_ENABLED=true
EXTERNAL_DISPATCH_URL=https://enqueuer-api-907757756276.us-central1.run.app/enqueue
FILTROS_API_KEY=your_filtros_api_key_here
EXTERNAL_DISPATCH_CALLBACK_BASE_URL=https://your-cloud-run-url.run.app

# ----------------------------------------------------------------------------
# Aplicación
# ----------------------------------------------------------------------------
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG
CORS_ORIGINS=*
